{
  "name": "dms-desktop",
  "productName": "DMS",
  "version": "0.1.0",
  "private": true,
  "description": "DMS – Predigten, Vorträge und Bibel als Mac-App",
  "author": "Sascha Wiebe",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac dmg --arm64 --publish never"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "de.hausundrasen.dms",
    "productName": "DMS",
    "copyright": "Sascha Wiebe",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../.next/standalone",
        "to": "server",
        "filter": [
          "**/*",
          "!**/*.map"
        ]
      }
    ],
    "npmRebuild": false,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "DMS",
      "artifactName": "DMS-${version}-arm64.${ext}"
    },
    "afterPack": "build/after-pack.cjs"
  }
}
