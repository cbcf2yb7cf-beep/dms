# Lokale Entwicklung (npm run dev) – als .env.local kopieren. .env* wird nie eingecheckt.
DATABASE_PATH=./data/app.db
NEXTAUTH_SECRET=bitte-ersetzen   # z. B. mit: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
# Legt beim allerersten Start den Login an (nur für die Entwicklung im Browser):
ADMIN_NAME=Sascha
ADMIN_EMAIL=dev@example.com
ADMIN_PASSWORD=entwicklung-lokal
# Optional für den Assistenten (Phase 7) – in der Mac-App stattdessen in den Einstellungen eintragen:
ANTHROPIC_API_KEY=
